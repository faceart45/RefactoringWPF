<Window x:Class="RefactoringWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RefactoringWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
            <TextBox x:Name="txtCustomer" Width="120" Margin="5" 
                     Text="Customer"/>
            <TextBox x:Name="txtProduct" Width="120" Margin="5" 
                     Text="Product"/>
            <TextBox x:Name="txtQty" Width="60" Margin="5" Text="1"/>
            <TextBox x:Name="txtPrice" Width="80" Margin="5" Text="100"/>
            <Button Content="Добавить" Click="Button_Click" Margin="5"/>
        </StackPanel>

        <DataGrid x:Name="dgOrders" Grid.Row="1" Margin="10" 
                  AutoGenerateColumns="True"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10">
            <TextBlock x:Name="lblTotal" Margin="5" FontWeight="Bold"/>
            <Button Content="Обновить" Click="Button_Click_1" Margin="5"/>
            <Button Content="Удалить" Click="Button_Click_2" Margin="5"/>
            <Button Content="Скидка" Click="Button_Click_3" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
