<Window x:Class="RefactoringWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RefactoringWPF"
        xmlns:vm="clr-namespace:RefactoringWPF.ViewModels"
        mc:Ignorable="d"
        Title="Менеджер заказов" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель добавления заказа -->
        <GroupBox Grid.Row="0" Header="Добавить новый заказ" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <StackPanel.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="Width" Value="120"/>
                        <Setter Property="Margin" Value="5"/>
                        <Setter Property="Padding" Value="5"/>
                    </Style>
                </StackPanel.Resources>

                <TextBox x:Name="txtCustomer" 
                         Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Email клиента"/>

                <TextBox x:Name="txtProduct" 
                         Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Название товара"/>

                <TextBox Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Количество"/>

                <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Цена"/>

                <Button Content=" Добавить" 
                        Command="{Binding AddOrderCommand}"
                        Margin="5" Padding="10,5"/>
            </StackPanel>
        </GroupBox>

        <!-- Таблица заказов -->
        <DataGrid Grid.Row="1" 
                  ItemsSource="{Binding Orders}"
                  SelectedItem="{Binding SelectedOrder}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  AlternatingRowBackground="#F0F0F0"
                  Margin="0,0,0,10">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Клиент (Email)" Binding="{Binding CustomerName}" Width="150"/>
                <DataGridTextColumn Header="Товар" Binding="{Binding ProductName}" Width="150"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N2} ₽}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total, StringFormat={}{0:N2} ₽}" Width="100"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding StatusRussian}" Width="100"/>
                <DataGridTextColumn Header="Скидка" Binding="{Binding DiscountInfo}" Width="120"/>
                <DataGridTextColumn Header="Дата создания" Binding="{Binding CreatedDate, StringFormat={}{0:dd.MM.yyyy}}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Панель действий -->
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="Gray" 
                       VerticalAlignment="Center" 
                       Margin="5"/>

            <TextBlock Text="Итого: " 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       Margin="10,0,0,0"/>

            <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N2} ₽}" 
                       FontWeight="Bold" 
                       FontSize="14" 
                       VerticalAlignment="Center"/>

            <Button Content="Обновить" 
                    Command="{Binding RefreshCommand}"
                    Margin="10,0,5,0" Padding="10,5"/>

            <Button Content="Удалить" 
                    Command="{Binding DeleteOrderCommand}"
                    Margin="5" Padding="10,5"/>

            <Button Content="Скидка" 
                    Command="{Binding ShowDiscountCommand}"
                    Margin="5" Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>